# Copy to .env (do not commit .env).

# mail (CFG_A3 supports comma-separated addresses)
CFG_A1=发件人邮箱
CFG_A2=发件人邮件专用密码
CFG_A3=收件人邮箱(多个用逗号隔开)

# http
CFG_B1=Google calendar的service-account文件
CFG_B2=固定值"kawaguchi-city"

# calendar (CFG_C1 service-account JSON; CFG_C2 予約; CFG_C3 抽選)
# Scope: https://www.googleapis.com/auth/calendar (read+write; shared by scan mail + sync)
# CFG_C1 = path to service-account JSON (e.g. local/service-account.json)
# CFG_C2 = calendar id (予約) — reservation sync writes here
# CFG_C3 = calendar id (抽選)
# CFG_C4 = calendar id (月度予約統計)
CFG_C1=
CFG_C2=
CFG_C3=
CFG_C4=

# heartbeat (optional; leave empty to skip)
# CFG_D1 = healthcheck / uptime ping URL (GET after successful scan_daily run)
# CFG_D2 = healthcheck / uptime ping URL (GET after successful sync_calendar run)
# CFG_D3 = healthcheck / uptime ping URL (GET after successful lottery_scan run)
CFG_D1=
CFG_D2=
CFG_D3=

# booking group credentials live in local/groups.json (see local/groups.example.json)
